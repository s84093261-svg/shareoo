ength","value":"5966"},{"name":"Connection","value":"keep-alive"},{"name":"access-control-allow-origin","value":"https://gainerspanel.netlify.app"},{"name":"Cache-Control","value":"no-cache"},{"name":"Strict-Transport-Security","value":"max-age=31556926; includeSubDomains; preload"}],"content":{"size":5966,"mimeType":"application/json","text":"{\"1793806938923\":{\"dateTime\":\"04-11-2026 | 09:12 PM\",\"id\":1793806938923,\"message\":\"మీ ప్రాంతంలో పిడుగులు పడే అవకాశం ఉంది.ఉరుములు మెరుపులతో కూడిన వర్షం పడేప్పుడు చెట్లు,టవర్స్,పోల్స్,పొలాలు,బహిరంగ ప్రదేశాల్లో ఉండరాదు.సురక్షితమైన భవనాల్లో ఆశ్రయం పొందండి-ఆంధ్రప్రదేశ్ ప్రభుత్వం.\",\"sender\":\"JG-NDMAEW-G\",\"type\":\"incoming\"},\"1793856005589\":{\"dateTime\":\"05-11-2026 | 10:50 AM\",\"id\":1793856005589,\"message\":\"మీ Jio నంబర్ 8143164630 యొక్క ప్లాన్ గడువు త్వరలోనే ముగియనున్నది. సేవలు నిలిపివేయకుండా ఉండటానికి వెంటనే రీఛార్జ్ చేయండి. రీఛార్జ్ చేయడానికి ఈ లింక్ www.jio.com/r/Veze436BS క్లిక్ చేయండి. ఇతర ప్లాన్ వివరాలకు 1991 కు కాల్ చేయండి.\",\"sender\":\"JA-JIOINF-S\",\"type\":\"incoming\"},\"1793857849419\":{\"dateTime\":\"05-11-2026 | 11:20 AM\",\"id\":1793857849419,\"message\":\"623873 is your One time password (OTP) to sign-in to your account on www.jio.com.\\nPlease enter the OTP to proceed.\\n@www.jio.com #623873\",\"sender\":\"JM-JIONET-S\",\"type\":\"incoming\"},\"1793859829574\":{\"dateTime\":\"05-11-2026 | 11:53 AM\",\"id\":1793859829574,\"message\":\"మీ Jio నంబర్ 8143164630 ప్లాన్ త్వరలో గడువు ముగియనుంది. అన్‌లిమిటెడ్ 5G, వాయిస్, 2.5 GB/రోజుకు డేటా 200 రోజులకు మరియు Canva Pro Lite, JioHotstar Mobile+Hollywood కోసం Rs.2025 తో రీచార్జ్ చేయండి. నిబంధనలు మరియు షరతులు వర్తిస్తాయి. www.jio.com/r/ER53sNDuA\",\"sender\":\"JM-620014-P\",\"type\":\"incoming\"},\"1793861926958\":{\"dateTime\":\"05-11-2026 | 12:28 PM\",\"id\":1793861926958,\"message\":\"092746 is your One time password (OTP) to sign-in to your account on www.jio.com.\\nPlease enter the OTP to proceed.\\n@www.jio.com #092746\",\"sender\":\"JX-JIONET-